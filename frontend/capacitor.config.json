{
  "appId": "com.covenantsynergy.edutrack",
  "appName": "EduTrack",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "http://192.168.1.42:3000",
    "cleartext": true,
    "androidScheme": "http"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0F172A"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0F172A"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
